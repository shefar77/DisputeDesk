# DisputeDesk configuration. Every variable is optional.
# With nothing set, the app runs in DEMO MODE: fixture disputes, no outbound calls.
# Copy to .env and fill in only what you want to enable. Never commit .env.

# --- PayPal (sandbox only; PAYPAL_ENV=live is refused) ------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the sandbox app's webhook settings; enables signature checks.
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
POLL_INTERVAL_MINUTES=10
# Force demo mode even when credentials are present.
DEMO_MODE=

# --- LLM (absent -> rule-based generator) ---------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default model when GEMINI_API_KEY is set. Flash is the right tier here: the
# three tasks are short, schema-constrained and run on every dispute.
LLM_MODEL=gemini-3.8-flash
# Optional: force a provider. Otherwise whichever key is present is used,
# Gemini first. Values: gemini | anthropic
LLM_PROVIDER=
# Alternative provider; set LLM_PROVIDER=anthropic and LLM_MODEL=claude-opus-5-5.
ANTHROPIC_API_KEY=
# Hard daily spend cap in USD; calls stop and fall back to rules when reached.
LLM_DAILY_CAP_USD=5
# Per-call ceilings. Thinking tokens count towards max output tokens.
LLM_MAX_TOKENS=8192
LLM_TIMEOUT_MS=60000

# --- Database (absent -> embedded PGlite under .data/) --------------------------
DATABASE_URL=

# --- Elastic (absent -> Postgres full-text search) ------------------------------
ELASTIC_URL=
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=

# --- KERNEL cloud browser (absent -> PayPal tracking data / manual upload) ------
KERNEL_API_KEY=

# --- Access ----------------------------------------------------------------------
# Set to require a shared password for the UI (recommended for a public demo).
DEMO_PASSWORD=
SESSION_SECRET=change-me-to-a-long-random-string
OPERATOR_NAME="Demo Merchant"
# Shared secret for the Render cron job (POST /api/cron/poll).
CRON_SECRET=

# --- Demo / testing ------------------------------------------------------------
# Inject a failure into the first attempt of a workflow step to show retries.
# CHAOS_FAIL_STEP=carrier_capture:1
PORT=8787
