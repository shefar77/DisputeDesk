{
  "info": {
    "name": "DisputeDesk",
    "_postman_id": "5b1e0c4e-7d1a-4c55-9a0e-0d15d0d35c01",
    "description": "DisputeDesk internal API (run in CI against demo mode via Newman) and the PayPal sandbox Disputes calls used for the Day-1 spike. The PayPal folder needs sandbox credentials and is not run in CI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "DisputeDesk API",
      "description": "npm run postman — the server must be running in demo mode on {{baseUrl}}.",
      "item": [
        {
          "name": "Session (CSRF token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set('csrf', j.csrfToken);",
                  "pm.test('demo mode', () => pm.expect(j.mode).to.eql('demo'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "session"
              ]
            }
          }
        },
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('dependencies list fallbacks', () => pm.response.json().dependencies.forEach((d) => pm.expect(d).to.have.property('fallback')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          }
        },
        {
          "name": "Reset demo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/demo/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "demo",
                "reset"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
