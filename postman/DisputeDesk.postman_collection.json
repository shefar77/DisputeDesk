    },
    {
      "name": "PayPal sandbox (needs credentials; not run in CI)",
      "description": "Day-1 spike calls (PRD §12, gate G0). Fill in the sandbox environment, then run \"OAuth token\" first.",
      "item": [
        {
          "name": "OAuth token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "pm.environment.set('paypalAccessToken', j.access_token);",
                  "pm.test('token issued', () => pm.expect(j.access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{paypalClientId}}"
                },
                {
                  "key": "password",
                  "value": "{{paypalClientSecret}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/v1/oauth2/token",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "oauth2",
                "token"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "client_credentials"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "List disputes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const items = pm.response.json().items || [];",
                  "if (items[0]) pm.environment.set('disputeId', items[0].dispute_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalAccessToken}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/v1/customer/disputes?page_size=20",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes"
              ],
              "query": [
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Show dispute (record the links)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "console.log('rels:', (pm.response.json().links || []).map((l) => l.rel).join(', '));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalAccessToken}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/v1/customer/disputes/{{disputeId}}",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{disputeId}}"
              ]
            },
            "description": "G0 step 2: record which HATEOAS rels appear."
          }
        },
        {
          "name": "Provide evidence (JSON with tracking)",
          "event": [],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalAccessToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v1/customer/disputes/{{disputeId}}/provide-evidence",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{disputeId}}",
                "provide-evidence"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"evidences\": [\n    {\n      \"evidence_type\": \"PROOF_OF_FULFILLMENT\",\n      \"evidence_info\": {\n        \"tracking_info\": [\n          {\n            \"carrier_name\": \"UPS\",\n            \"tracking_number\": \"1Z999AA10123456784\"\n          }\n        ]\n      },\n      \"notes\": \"Spike test from the DisputeDesk Postman collection (sandbox).\"\n    }\n  ]\n}"
            },
            "description": "Only when the provide-evidence link is present. Sandbox only."
          }
        },
        {
          "name": "Send message",
          "event": [],
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalAccessToken}}"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{paypalBase}}/v1/customer/disputes/{{disputeId}}/send-message",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "customer",
                "disputes",
                "{{disputeId}}",
                "send-message"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Spike test message (sandbox).\"\n}"
            },
            "description": ""
          }
        },
        {
          "name": "List trackers for a transaction",
          "event": [],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{paypalAccessToken}}"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{paypalBase}}/v1/shipping/trackers?transaction_id={{transactionId}}",
              "host": [
                "{{paypalBase}}"
              ],
              "path": [
                "v1",
                "shipping",
                "trackers"
              ],
              "query": [
                {
                  "key": "transaction_id",
                  "value": "{{transactionId}}"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ]
}