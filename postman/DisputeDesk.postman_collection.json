        },
        {
          "name": "Replaying the same approval is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/disputes/PP-D-FIX-00001/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "disputes",
                "PP-D-FIX-00001",
                "approve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"provide-evidence\",\n  \"payload_sha256\": \"{{payloadHash}}\"\n}"
            }
          }
        },
        {
          "name": "Offer above the disputed amount is refused",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrf}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/disputes/PP-D-FIX-00002/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "disputes",
                "PP-D-FIX-00002",
                "preview"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"make-offer\",\n  \"offer\": {\n    \"offer_type\": \"REFUND\",\n    \"amount\": \"999.00\",\n    \"note\": \"test\"\n  }\n}"
            }
          }
        },
        {
          "name": "Audit log",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const ev = pm.response.json().entries.map((e) => e.event);",
                  "pm.test('approval and write recorded', () => { pm.expect(ev).to.include('approval.granted'); pm.expect(ev).to.include('paypal.write'); });",
                  "pm.test('no bearer tokens', () => pm.expect(pm.response.text()).to.not.match(/Bearer\\s+A21/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "audit"
              ]
            }
          }
